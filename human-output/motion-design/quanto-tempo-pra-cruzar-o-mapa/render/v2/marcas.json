 "batidas": [
  {
   "cena": "abertura",
   "tipo": "luz",
   "t": 0,
   "texto": "A linha do horizonte corre do centro para as pontas."
  },
  {
   "cena": "abertura",
   "tipo": "luz",
   "t": 0.15,
   "texto": "O céu queima de baixo para cima; o sol nasce no mar."
  },
  {
   "cena": "abertura",
   "tipo": "tipo",
   "t": 0.5,
   "texto": "\"QUANTO TEMPO\" sai do desfoque."
  },
  {
   "cena": "abertura",
   "tipo": "objeto",
   "t": 0.55,
   "texto": "Palmeiras e cidade sobem em silhueta."
  },
  {
   "cena": "abertura",
   "tipo": "tipo",
   "t": 0.75,
   "texto": "\"PRA CRUZAR\"."
  },
  {
   "cena": "abertura",
   "tipo": "tipo",
   "t": 0.9,
   "texto": "\"O MAPA?\" pela lente, no degradê."
  },
  {
   "cena": "abertura",
   "tipo": "luz",
   "t": 2.1,
   "texto": "Um brilho atravessa \"O MAPA?\" uma vez; o degradê deriva."
  },
  {
   "cena": "mapa",
   "tipo": "camera",
   "t": 3,
   "texto": "A ilha sai do desfoque; a câmera começa a recuar."
  },
  {
   "cena": "mapa",
   "tipo": "tipo",
   "t": 3.3,
   "texto": "\"QUANTO TEMPO PRA / CRUZAR O MAPA?\" no alto, à esquerda."
  },
  {
   "cena": "mapa",
   "tipo": "tipo",
   "t": 4,
   "texto": "As três linhas entram apagadas."
  },
  {
   "cena": "mapa",
   "tipo": "luz",
   "t": 4.5,
   "texto": "A pé: a linha rosa se desenha em 3 s; 0 → 178 MIN e trava com brilho."
  },
  {
   "cena": "mapa",
   "tipo": "luz",
   "t": 5.5,
   "texto": "Cada cidade acende quando uma linha passa por ela."
  },
  {
   "cena": "mapa",
   "tipo": "luz",
   "t": 7.5,
   "texto": "178 trava com um brilho; o ponto de luz chega ao norte."
  },
  {
   "cena": "mapa",
   "tipo": "luz",
   "t": 7.9,
   "texto": "De carro: a linha laranja pela costa em 2 s; 0 → 35."
  },
  {
   "cena": "mapa",
   "tipo": "luz",
   "t": 10.2,
   "texto": "De avião: um risco dourado reto em 0,8 s; 0 → 7."
  },
  {
   "cena": "fecho",
   "tipo": "tipo",
   "t": 12.05,
   "texto": "\"A PÉ, É QUASE\"."
  },
  {
   "cena": "fecho",
   "tipo": "tipo",
   "t": 12.55,
   "texto": "\"3 HORAS\" pela lente, no degradê."
  },
  {
   "cena": "fecho",
   "tipo": "tipo",
   "t": 13.05,
   "texto": "\"DE AVIÃO: 7 MINUTOS\"."
  },
  {
   "cena": "fecho",
   "tipo": "vida",
   "t": 13.55,
   "texto": "O sol respira e o mar cintila; um brilho passa por \"3 HORAS\" (2,0 s)."
  },
  {
   "cena": "fecho",
   "tipo": "luz",
   "t": 14.25,
   "texto": "O sol afunda no mar."
  },
  {
   "cena": "fecho",
   "tipo": "transicao",
   "t": 15.1,
   "texto": "Tudo sai; o horizonte encolhe até um ponto e apaga."
  }
