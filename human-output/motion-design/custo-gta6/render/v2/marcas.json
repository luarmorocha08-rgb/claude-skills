 "batidas": [
  {
   "cena": "abertura",
   "tipo": "luz",
   "t": 0,
   "texto": "A linha do horizonte nasce como um ponto no centro e corre para as pontas em 600 ms."
  },
  {
   "cena": "abertura",
   "tipo": "luz",
   "t": 0.4,
   "texto": "O céu queima de baixo para cima (preto → roxo → rosa → laranja) e o sol sobe meia altura do mar."
  },
  {
   "cena": "abertura",
   "tipo": "objeto",
   "t": 0.75,
   "texto": "As palmeiras sobem das bordas com paralaxe; a cidade aparece em silhueta no horizonte."
  },
  {
   "cena": "abertura",
   "tipo": "tipo",
   "t": 1,
   "texto": "\"QUANTO CUSTOU\" sai do desfoque palavra a palavra, 45 ms entre elas."
  },
  {
   "cena": "abertura",
   "tipo": "tipo",
   "t": 1.5,
   "texto": "Na batida, \"GTA VI?\" chega da profundidade letra a letra e acende no degradê do pôr do sol."
  },
  {
   "cena": "abertura",
   "tipo": "luz",
   "t": 2.8,
   "texto": "Um brilho atravessa \"GTA VI?\" uma vez; o sol respira."
  },
  {
   "cena": "abertura",
   "tipo": "transicao",
   "t": 3.75,
   "texto": "A câmera mergulha para o horizonte: o título sobe e sai desfocando, o chão vira o palco da próxima."
  },
  {
   "cena": "gta5",
   "tipo": "tipo",
   "t": 4,
   "texto": "\"2013\" vazado e gigante assenta no céu, de 110 % para 100 %, devagar."
  },
  {
   "cena": "gta5",
   "tipo": "objeto",
   "t": 4.5,
   "texto": "A torre rompe a linha do horizonte e sobe maço por maço em 1,5 s, girando; pousa com uma mola curta."
  },
  {
   "cena": "gta5",
   "tipo": "tipo",
   "t": 5,
   "texto": "\"GTA V · 2013\" aparece no topo e o valor conta de US$ 0 a US$ 265 mi, travando na batida 2,0 s."
  },
  {
   "cena": "gta5",
   "tipo": "tipo",
   "t": 6.5,
   "texto": "A nota \"desenvolvimento + marketing\" sobe do desfoque."
  },
  {
   "cena": "gta5",
   "tipo": "vida",
   "t": 7,
   "texto": "Hold: a torre continua girando 2°/s, o sol respira, o mar cintila."
  },
  {
   "cena": "recorde",
   "tipo": "tipo",
   "t": 9,
   "texto": "\"Na época, foi\" sobe do desfoque."
  },
  {
   "cena": "gta5",
   "tipo": "transicao",
   "t": 9.2,
   "texto": "Tilt rápido para cima: a câmera sobe para o céu (corte no eixo vertical)."
  },
  {
   "cena": "recorde",
   "tipo": "tipo",
   "t": 9.25,
   "texto": "A frase entra palavra a palavra, 45 ms entre elas."
  },
  {
   "cena": "recorde",
   "tipo": "luz",
   "t": 9.75,
   "texto": "Um véu macio varre \"mais caro\" e acende o degradê do pôr do sol."
  },
  {
   "cena": "recorde",
   "tipo": "vida",
   "t": 10.5,
   "texto": "Hold: palmeiras balançam um fio, a luz respira."
  },
  {
   "cena": "recorde",
   "tipo": "luz",
   "t": 11,
   "texto": "Um brilho atravessa \"mais caro\" uma vez."
  },
  {
   "cena": "gta6",
   "tipo": "objeto",
   "t": 11.5,
   "texto": "A torre rompe o mar com força e sobe acelerando, girando devagar."
  },
  {
   "cena": "recorde",
   "tipo": "transicao",
   "t": 11.75,
   "texto": "Tilt rápido para baixo, de volta ao mar: a próxima torre já está nascendo."
  },
  {
   "cena": "gta6",
   "tipo": "camera",
   "t": 12.5,
   "texto": "Quando ela fura o topo do quadro, a câmera treme um fio (só o objeto tem peso)."
  },
  {
   "cena": "gta6",
   "tipo": "tipo",
   "t": 12.75,
   "texto": "\"GTA VI\" sobe do desfoque à esquerda."
  },
  {
   "cena": "gta6",
   "tipo": "tipo",
   "t": 13.25,
   "texto": "O valor rola como odômetro (US$ 0 → 2 bi), cada coluna travando da esquerda para a direita; trava na batida 3,0 s."
  },
  {
   "cena": "gta6",
   "tipo": "tipo",
   "t": 14.75,
   "texto": "\"até\" e a nota \"estimativas de US$ 1 a 2 bilhões\" sobem do desfoque."
  },
  {
   "cena": "gta6",
   "tipo": "luz",
   "t": 15,
   "texto": "Um brilho atravessa o valor uma vez."
  },
  {
   "cena": "gta6",
   "tipo": "vida",
   "t": 16,
   "texto": "Hold: a torre segue subindo devagar e girando; o mar cintila."
  },
  {
   "cena": "gta6",
   "tipo": "luz",
   "t": 17,
   "texto": "O topo da torre reflete o sol: uma faixa de luz desce pela fachada."
  },
  {
   "cena": "gta6",
   "tipo": "transicao",
   "t": 17.7,
   "texto": "A câmera recua para o céu aberto: a próxima mostra as duas torres juntas."
  },
  {
   "cena": "comparacao",
   "tipo": "camera",
   "t": 18,
   "texto": "A câmera recua revelando a torre de GTA V pequena no horizonte."
  },
  {
   "cena": "comparacao",
   "tipo": "objeto",
   "t": 18.5,
   "texto": "Ao lado, a torre de GTA VI sobe até 7,5× a altura da outra em 1,2 s (proporção real: 265 mi × 2 bi)."
  },
  {
   "cena": "comparacao",
   "tipo": "tipo",
   "t": 19.75,
   "texto": "\"ATÉ\" sobe do desfoque."
  },
  {
   "cena": "comparacao",
   "tipo": "tipo",
   "t": 20,
   "texto": "Na batida, \"7X\" chega da profundidade, gigante, e trava com um empurrão de peso da câmera de 1,2 %."
  },
  {
   "cena": "comparacao",
   "tipo": "tipo",
   "t": 20.5,
   "texto": "\"MAIS CARO\" sobe do desfoque."
  },
  {
   "cena": "comparacao",
   "tipo": "vida",
   "t": 21,
   "texto": "Hold: as torres giram juntas, o degradê do 7X deriva."
  },
  {
   "cena": "comparacao",
   "tipo": "luz",
   "t": 22,
   "texto": "Um brilho atravessa o \"7X\" uma vez."
  },
  {
   "cena": "comparacao",
   "tipo": "vida",
   "t": 23,
   "texto": "O sol começa a afundar; a luz das torres esfria."
  },
  {
   "cena": "ressalva",
   "tipo": "tipo",
   "t": 23.6,
   "texto": "\"Detalhe\" sobe do desfoque."
  },
  {
   "cena": "comparacao",
   "tipo": "transicao",
   "t": 23.75,
   "texto": "O sol se põe de vez: a luz cai para a noite da próxima."
  },
  {
   "cena": "ressalva",
   "tipo": "tipo",
   "t": 23.85,
   "texto": "A frase acende letra a letra como neon ligando (um tremor macio de brilho, sem piscar)."
  },
  {
   "cena": "ressalva",
   "tipo": "tipo",
   "t": 24.6,
   "texto": "A nota \"os números são estimativas de mercado\" sobe do desfoque."
  },
  {
   "cena": "ressalva",
   "tipo": "luz",
   "t": 25.1,
   "texto": "Um brilho atravessa \"NUNCA\" uma vez."
  },
  {
   "cena": "ressalva",
   "tipo": "vida",
   "t": 25.6,
   "texto": "Hold: o degradê de \"NUNCA\" deriva; as palmeiras balançam um fio."
  },
  {
   "cena": "fecho",
   "tipo": "tipo",
   "t": 26.2,
   "texto": "\"VAI VALER\" sai do desfoque palavra a palavra."
  },
  {
   "cena": "ressalva",
   "tipo": "transicao",
   "t": 26.35,
   "texto": "O céu volta a queimar: amanhece de novo o pôr do sol do começo."
  },
  {
   "cena": "fecho",
   "tipo": "tipo",
   "t": 26.7,
   "texto": "Na batida, \"CADA CENTAVO?\" chega da profundidade letra a letra no degradê."
  },
  {
   "cena": "fecho",
   "tipo": "luz",
   "t": 27.7,
   "texto": "Um brilho atravessa a pergunta uma vez."
  },
  {
   "cena": "fecho",
   "tipo": "vida",
   "t": 28.7,
   "texto": "Hold: o degradê da pergunta deriva; o sol começa a descer."
  },
  {
   "cena": "fecho",
   "tipo": "luz",
   "t": 29.7,
   "texto": "O sol afunda no mar; o céu escurece de cima para baixo."
  },
  {
   "cena": "fecho",
   "tipo": "transicao",
   "t": 30.6,
   "texto": "O texto sobe e desfoca, a linha do horizonte encolhe até um ponto e apaga: último quadro preto."
  }
 ],
