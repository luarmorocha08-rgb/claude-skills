 "batidas": [
  {
   "cena": "tensao",
   "tipo": "objeto",
   "t": 0,
   "texto": "As metades entram voando de fora do quadro, com rastro de movimento, e batem a 17 cqw uma da outra em 420 ms."
  },
  {
   "cena": "tensao",
   "tipo": "camera",
   "t": 0.42,
   "texto": "BUM: a câmera recebe o peso (3 %) com um tremor curto; a fenda pisca."
  },
  {
   "cena": "tensao",
   "tipo": "tipo",
   "t": 1,
   "texto": "O relógio sai do desfoque: “você está aqui há 1 segundo”; cada segundo vira na hora certa."
  },
  {
   "cena": "tensao",
   "tipo": "luz",
   "t": 1,
   "texto": "Batimento: a brasa pulsa em batidas cada vez mais próximas (750 → 200 ms), cada uma mais quente."
  },
  {
   "cena": "tensao",
   "tipo": "camera",
   "t": 3,
   "texto": "A um fio: tremor mínimo na câmera e nas metades."
  },
  {
   "cena": "tensao",
   "tipo": "transicao",
   "t": 4.25,
   "texto": "O relógio sobe e se desfaz; corte no mesmo eixo."
  },
  {
   "cena": "virada",
   "tipo": "tipo",
   "t": 4.55,
   "texto": "“Você ficou 4 segundos” sai do desfoque palavra a palavra."
  },
  {
   "cena": "virada",
   "tipo": "tipo",
   "t": 4.9,
   "texto": "“esperando isso encostar” sobe por baixo, mais apagada."
  },
  {
   "cena": "virada",
   "tipo": "luz",
   "t": 5.4,
   "texto": "A brasa pulsa em cada batida, cada vez mais forte."
  },
  {
   "cena": "virada",
   "tipo": "transicao",
   "t": 6.7,
   "texto": "As frases recuam para o desfoque e a fenda começa a abrir."
  },
  {
   "cena": "promessa",
   "tipo": "objeto",
   "t": 7.5,
   "texto": "As metades se separam e saem pelas bordas em 750 ms, acelerando."
  },
  {
   "cena": "promessa",
   "tipo": "luz",
   "t": 7.55,
   "texto": "A brasa abre na vertical e vira um campo de luz quente."
  },
  {
   "cena": "promessa",
   "tipo": "tipo",
   "t": 7.9,
   "texto": "A frase sai do desfoque palavra a palavra."
  },
  {
   "cena": "promessa",
   "tipo": "luz",
   "t": 8.4,
   "texto": "“atenção” é varrida da cor do texto para a brasa."
  },
  {
   "cena": "promessa",
   "tipo": "transicao",
   "t": 10.22,
   "texto": "A frase é sugada para uma linha de luz, que vira a fenda dos números."
  },
  {
   "cena": "dados",
   "tipo": "tipo",
   "t": 11,
   "texto": "“A atenção decide” fica no alto a cena toda."
  },
  {
   "cena": "dados",
   "tipo": "objeto",
   "t": 11.32,
   "texto": "As metades de 0,05s batem e encostam; estalo de luz na emenda; a legenda sobe palavra a palavra e a fonte aparece."
  },
  {
   "cena": "dados",
   "tipo": "transicao",
   "t": 12.25,
   "texto": "O número se parte para cima e para baixo, acelerando."
  },
  {
   "cena": "dados",
   "tipo": "objeto",
   "t": 12.82,
   "texto": "46% encosta na batida, mesmo estalo."
  },
  {
   "cena": "dados",
   "tipo": "objeto",
   "t": 14.32,
   "texto": "53% encosta; a emenda esfria devagar."
  },
  {
   "cena": "dados",
   "tipo": "transicao",
   "t": 15.22,
   "texto": "Tudo se parte e sai; corte para o convite."
  },
  {
   "cena": "convite",
   "tipo": "tipo",
   "t": 16,
   "texto": "“Quer um site assim?” sai do desfoque palavra a palavra."
  },
  {
   "cena": "convite",
   "tipo": "objeto",
   "t": 16.1,
   "texto": "As metades de SITES chegam de lados opostos e fecham acelerando."
  },
  {
   "cena": "convite",
   "tipo": "objeto",
   "t": 17,
   "texto": "Na batida: ENCOSTAM, estalo de luz na emenda e empurrão de 2 % na câmera."
  },
  {
   "cena": "convite",
   "tipo": "tipo",
   "t": 17.25,
   "texto": "“me chama no direct ou comenta” sobe palavra a palavra."
  },
  {
   "cena": "convite",
   "tipo": "luz",
   "t": 19,
   "texto": "Na última batida a brasa pulsa uma vez; o filme termina vivo."
  }
 ],
