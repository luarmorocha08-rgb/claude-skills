 "batidas": [
  {
   "cena": "tensao",
   "tipo": "objeto",
   "t": 0,
   "texto": "As metades entram pelas bordas, de cima e de baixo, rápidas no começo e cada vez mais devagar (como se nunca fossem chegar)."
  },
  {
   "cena": "tensao",
   "tipo": "tipo",
   "t": 1,
   "texto": "O relógio sai do desfoque: “você está aqui há 1 segundo”. Cada segundo vira na hora certa, o número sobe de pertinho."
  },
  {
   "cena": "tensao",
   "tipo": "luz",
   "t": 3,
   "texto": "A fenda entre elas acende do centro para as pontas e esquenta a cada centímetro que falta."
  },
  {
   "cena": "tensao",
   "tipo": "camera",
   "t": 4.5,
   "texto": "A um fio: a câmera treme 0,1 %, as metades dão dois micro-avanços e param (quase)."
  },
  {
   "cena": "tensao",
   "tipo": "vida",
   "t": 5.5,
   "texto": "Hold: a brasa respira, a câmera continua chegando; nada encosta."
  },
  {
   "cena": "virada",
   "tipo": "tipo",
   "t": 6,
   "texto": "O relógio sobe e se desfaz em 250 ms."
  },
  {
   "cena": "virada",
   "tipo": "tipo",
   "t": 6.1,
   "texto": "“Você ficou 6 segundos” sai do desfoque, palavra a palavra, 45 ms entre elas."
  },
  {
   "cena": "virada",
   "tipo": "tipo",
   "t": 6.6,
   "texto": "Na batida, “esperando isso encostar” sobe por baixo, mais apagada."
  },
  {
   "cena": "virada",
   "tipo": "vida",
   "t": 7.5,
   "texto": "Hold: a brasa respira, as metades tremem a um fio."
  },
  {
   "cena": "virada",
   "tipo": "luz",
   "t": 8,
   "texto": "Na batida, a brasa da fenda dá um pulso de calor, como se fosse encostar agora."
  },
  {
   "cena": "virada",
   "tipo": "transicao",
   "t": 8.6,
   "texto": "As duas frases recuam para o desfoque e a fenda começa a abrir."
  },
  {
   "cena": "promessa",
   "tipo": "objeto",
   "t": 9,
   "texto": "As metades se separam com arranque macio e saem pelas bordas em 600 ms, acelerando."
  },
  {
   "cena": "promessa",
   "tipo": "luz",
   "t": 9.1,
   "texto": "A brasa da fenda abre na vertical e vira um campo de luz quente."
  },
  {
   "cena": "promessa",
   "tipo": "tipo",
   "t": 9.5,
   "texto": "A frase sai do desfoque linha a linha; “atenção” acende por último, na brasa."
  },
  {
   "cena": "promessa",
   "tipo": "luz",
   "t": 10,
   "texto": "Na batida, “atenção” é varrida da cor do texto para a brasa."
  },
  {
   "cena": "promessa",
   "tipo": "camera",
   "t": 10.5,
   "texto": "A câmera assenta e a luz de trás respira uma vez."
  },
  {
   "cena": "promessa",
   "tipo": "vida",
   "t": 11,
   "texto": "Hold: o degradê de “atenção” deriva e um brilho atravessa a palavra uma vez."
  },
  {
   "cena": "promessa",
   "tipo": "transicao",
   "t": 12.2,
   "texto": "A frase é sugada para uma linha horizontal de luz, que vira a fenda da próxima."
  },
  {
   "cena": "convite",
   "tipo": "tipo",
   "t": 12.5,
   "texto": "“Quer um site assim?” sai do desfoque palavra a palavra."
  },
  {
   "cena": "convite",
   "tipo": "objeto",
   "t": 13,
   "texto": "As metades de SITES entram pelas bordas, desta vez rápidas e decididas."
  },
  {
   "cena": "convite",
   "tipo": "objeto",
   "t": 14,
   "texto": "Batida 3: ENCOSTAM. Um estalo de luz corre pela emenda do centro para as pontas e a câmera recebe o peso (2 %)."
  },
  {
   "cena": "convite",
   "tipo": "tipo",
   "t": 14.5,
   "texto": "“me chama no direct ou comenta” sobe palavra a palavra, apontando para SITES."
  },
  {
   "cena": "convite",
   "tipo": "vida",
   "t": 15.3,
   "texto": "Hold até o fim: a emenda esfria devagar, o degradê de SITES deriva."
  },
  {
   "cena": "convite",
   "tipo": "luz",
   "t": 16,
   "texto": "Na última batida, um brilho atravessa SITES uma vez e o filme termina vivo, pronto para recomeçar."
  }
 ],
