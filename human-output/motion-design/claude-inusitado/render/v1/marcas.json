 "batidas": [
  {
   "cena": "gancho",
   "tipo": "tipo",
   "t": 0.05,
   "texto": "A moldura nasce de cima para baixo: selo, @, pílula, régua, trilha, cada peça 70 ms depois da outra, do desfoque para o foco."
  },
  {
   "cena": "gancho",
   "tipo": "tipo",
   "t": 0.2,
   "texto": "A frase sai do desfoque palavra a palavra, 45 ms entre elas; \"inusitado\" em itálico dourado."
  },
  {
   "cena": "gancho",
   "tipo": "objeto",
   "t": 0.75,
   "texto": "O card de conversa sobe 6 % com mola curta e a pergunta se escreve nele."
  },
  {
   "cena": "gancho",
   "tipo": "objeto",
   "t": 1.5,
   "texto": "Um jeito acende a cada 0,4 s (1,5 · 1,9 · 2,3 · 2,7 · 3,1): o chip ganha borda dourada e o contador pula 1 → 5 com um empurrão pequeno."
  },
  {
   "cena": "gancho",
   "tipo": "vida",
   "t": 3.2,
   "texto": "Hold: a poeira sobe, a luz respira, o último chip brilha uma vez."
  },
  {
   "cena": "gancho",
   "tipo": "transicao",
   "t": 3.94,
   "texto": "O conteúdo desfoca e acelera para fora em 260 ms; corte seco; a moldura fica."
  },
  {
   "cena": "wifi",
   "tipo": "transicao",
   "t": 4.3,
   "texto": "Na trilha, o cursor de luz anda até 01 e acende; a pílula troca para \"Passo 1 · Wi‑Fi\"."
  },
  {
   "cena": "wifi",
   "tipo": "tipo",
   "t": 4.3,
   "texto": "O título sai do desfoque palavra a palavra; \"Wi‑Fi lento\" em itálico dourado."
  },
  {
   "cena": "wifi",
   "tipo": "objeto",
   "t": 4.9,
   "texto": "O terminal de vidro sobe; o pedido se digita na primeira linha."
  },
  {
   "cena": "wifi",
   "tipo": "objeto",
   "t": 6.5,
   "texto": "Quatro linhas de resultado caem uma por batida, cada uma com um estalo; a latência conta de 40 até 189 ms e fica vermelha."
  },
  {
   "cena": "wifi",
   "tipo": "objeto",
   "t": 8.7,
   "texto": "O carimbo \"troque pra 5 GHz\" bate girado, com tremor curto; a latência despenca para 12 ms e fica verde; a última linha confirma."
  },
  {
   "cena": "wifi",
   "tipo": "transicao",
   "t": 12.44,
   "texto": "Saída do conteúdo em 260 ms; corte."
  },
  {
   "cena": "exame",
   "tipo": "transicao",
   "t": 12.8,
   "texto": "O cursor anda até 02; a pílula troca; o número fantasma vira 02."
  },
  {
   "cena": "exame",
   "tipo": "tipo",
   "t": 12.8,
   "texto": "O título sai do desfoque; \"modelo 3D\" em itálico dourado."
  },
  {
   "cena": "exame",
   "tipo": "objeto",
   "t": 13.45,
   "texto": "As fatias caem de cima, uma a cada 45 ms, e empilham o volume de baixo para cima; o contador conta até 240."
  },
  {
   "cena": "exame",
   "tipo": "luz",
   "t": 14.1,
   "texto": "Uma lâmina de luz dourada sobe pelo volume e acende cada fatia quando passa."
  },
  {
   "cena": "exame",
   "tipo": "objeto",
   "t": 15.7,
   "texto": "O volume termina e começa a girar sobre o eixo; a nota \"só pra ver · quem interpreta é o médico\" entra embaixo."
  },
  {
   "cena": "exame",
   "tipo": "transicao",
   "t": 19.24,
   "texto": "Saída do conteúdo em 260 ms; corte."
  },
  {
   "cena": "tv",
   "tipo": "transicao",
   "t": 19.6,
   "texto": "O cursor anda até 03; a pílula troca."
  },
  {
   "cena": "tv",
   "tipo": "tipo",
   "t": 19.6,
   "texto": "O título sai do desfoque; \"sem anúncio\" em itálico dourado."
  },
  {
   "cena": "tv",
   "tipo": "objeto",
   "t": 20.15,
   "texto": "A TV de vidro acende com 6 blocos de anúncio."
  },
  {
   "cena": "tv",
   "tipo": "objeto",
   "t": 20.9,
   "texto": "Os anúncios despencam um a um com gravidade (accelerando de 200 → 120 ms); o contador desce até 0."
  },
  {
   "cena": "tv",
   "tipo": "objeto",
   "t": 21.95,
   "texto": "Entram os apps (mola curta, um a cada 70 ms) e os botões da sala, cozinha e quarto acendem um por batida."
  },
  {
   "cena": "tv",
   "tipo": "transicao",
   "t": 25.74,
   "texto": "Saída do conteúdo em 260 ms; corte."
  },
  {
   "cena": "buraco",
   "tipo": "transicao",
   "t": 26.1,
   "texto": "O cursor anda até 04; a pílula troca."
  },
  {
   "cena": "buraco",
   "tipo": "tipo",
   "t": 26.1,
   "texto": "O título sai do desfoque; \"cena 3D\" em itálico dourado."
  },
  {
   "cena": "buraco",
   "tipo": "objeto",
   "t": 26.5,
   "texto": "Três polaroides caem girando, uma por meia batida, com mola curta; o contador de fotos sobe até 3."
  },
  {
   "cena": "buraco",
   "tipo": "objeto",
   "t": 27.15,
   "texto": "As fotos encolhem para o canto e a rua se ergue de chapada para 3D em 700 ms; as faixas começam a correr."
  },
  {
   "cena": "buraco",
   "tipo": "luz",
   "t": 28.2,
   "texto": "O buraco acende em vermelho por baixo, sem borda; a etiqueta \"zona de risco\" desce presa a um fio."
  },
  {
   "cena": "buraco",
   "tipo": "transicao",
   "t": 31.14,
   "texto": "Saída do conteúdo em 260 ms; corte."
  },
  {
   "cena": "diagrama",
   "tipo": "transicao",
   "t": 31.5,
   "texto": "O cursor anda até 05; a pílula troca."
  },
  {
   "cena": "diagrama",
   "tipo": "tipo",
   "t": 31.5,
   "texto": "O título sai do desfoque; \"se mexem\" em itálico dourado."
  },
  {
   "cena": "diagrama",
   "tipo": "objeto",
   "t": 32.25,
   "texto": "A base, o trilho, a régua, a coluna e o relógio se traçam um a um (uma peça por meia batida); o contador conta 1 → 5."
  },
  {
   "cena": "diagrama",
   "tipo": "objeto",
   "t": 34.3,
   "texto": "O bloco começa a deslizar no trilho e o ponteiro do relógio acompanha, com um pequeno atraso de mola."
  },
  {
   "cena": "diagrama",
   "tipo": "vida",
   "t": 35,
   "texto": "Hold: o mecanismo segue funcionando em loop suave, nada para."
  },
  {
   "cena": "diagrama",
   "tipo": "transicao",
   "t": 37.04,
   "texto": "Saída do conteúdo em 260 ms; corte."
  },
  {
   "cena": "convite",
   "tipo": "transicao",
   "t": 37.4,
   "texto": "A trilha inteira fica dourada, do 05 até a ponta; a pílula vira \"Bônus · Prompts\"."
  },
  {
   "cena": "convite",
   "tipo": "tipo",
   "t": 37.4,
   "texto": "\"Quer os 5 prompts prontos?\" sai do desfoque; \"prompts\" em itálico dourado."
  },
  {
   "cena": "convite",
   "tipo": "objeto",
   "t": 37.9,
   "texto": "A caixa de comentário sobe com mola e a palavra Wi‑Fi se digita, letra a letra."
  },
  {
   "cena": "convite",
   "tipo": "objeto",
   "t": 39.05,
   "texto": "Enviar: a seta pulsa, a mensagem com o guia chega com mola e o selo \"1\" pula."
  },
  {
   "cena": "convite",
   "tipo": "transicao",
   "t": 40.8,
   "texto": "Fecho: o conteúdo escurece em 800 ms; no centro acendem o ícone do Instagram e @ramosraul.ia, e seguram até o fim."
  }
 ],
