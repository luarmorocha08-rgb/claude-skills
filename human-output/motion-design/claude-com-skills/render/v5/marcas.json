 "batidas": [
  {
   "cena": "pedido",
   "tipo": "luz",
   "t": 0.22,
   "texto": "Primeiro pulso da música: o cursor acende e respira."
  },
  {
   "cena": "pedido",
   "tipo": "tipo",
   "t": 0.5,
   "texto": "A digitação começa com ritmo humano (56 a 86 ms por letra); cada letra nasce quente e esfria; a câmera recua de 1,12× em 4,6 s."
  },
  {
   "cena": "pedido",
   "tipo": "luz",
   "t": 2.83,
   "texto": "Segundo pulso: a brasa atrás do cursor incha."
  },
  {
   "cena": "pedido",
   "tipo": "transicao",
   "t": 5,
   "texto": "As pontas partem primeiro e tudo converge num ponto; corte no pulso de 5,44 s."
  },
  {
   "cena": "faisca",
   "tipo": "luz",
   "t": 5.437,
   "texto": "No pulso, o ponto vira a faísca com uma mola curta, girando e esfriando."
  },
  {
   "cena": "faisca",
   "tipo": "objeto",
   "t": 6.037,
   "texto": "Meia chave em 240 ms com tique."
  },
  {
   "cena": "faisca",
   "tipo": "tipo",
   "t": 6.297,
   "texto": "Desliza e 'Claude' nasce da luz."
  },
  {
   "cena": "faisca",
   "tipo": "tipo",
   "t": 8.047,
   "texto": "No pulso seguinte, 'com skills' sobe e o destaque acende."
  },
  {
   "cena": "faisca",
   "tipo": "transicao",
   "t": 9.737,
   "texto": "Tudo é tragado para a faísca; ela vai ao centro, cresce e prende o ar para o drop."
  },
  {
   "cena": "oficios",
   "tipo": "luz",
   "t": 10.654,
   "texto": "Drop: a faísca solta, os oito feixes disparam em 40 ms cada, a câmera dá um empurrão de 3,5 %."
  },
  {
   "cena": "oficios",
   "tipo": "tipo",
   "t": 10.98,
   "texto": "Um ofício pousa por batida, no sentido do relógio, e a faísca pulsa junto."
  },
  {
   "cena": "oficios",
   "tipo": "luz",
   "t": 13.263,
   "texto": "Batida 8: uma onda de luz corre pelos feixes."
  },
  {
   "cena": "oficios",
   "tipo": "luz",
   "t": 14.567,
   "texto": "Batida 12: 'Motion design' esquenta e os outros apagam."
  },
  {
   "cena": "oficios",
   "tipo": "transicao",
   "t": 15.124,
   "texto": "Mergulho no 'o', chegando no início da frase seguinte."
  },
  {
   "cena": "bastidor",
   "tipo": "tipo",
   "t": 15.742,
   "texto": "'Inclusive este vídeo' sai do desfoque."
  },
  {
   "cena": "bastidor",
   "tipo": "objeto",
   "t": 16.042,
   "texto": "Os seis quadrinhos caem em colcheias (163 ms)."
  },
  {
   "cena": "bastidor",
   "tipo": "luz",
   "t": 17.508,
   "texto": "Um quadrinho acende por batida, com a barra de tempo dele."
  },
  {
   "cena": "bastidor",
   "tipo": "luz",
   "t": 19.464,
   "texto": "Brilho em 'este vídeo'."
  },
  {
   "cena": "bastidor",
   "tipo": "transicao",
   "t": 20.342,
   "texto": "Mergulho no quadrinho 5, chegando no início da frase seguinte."
  },
  {
   "cena": "entregas",
   "tipo": "objeto",
   "t": 21.1,
   "texto": "O cartão de Motion assenta no início da frase."
  },
  {
   "cena": "entregas",
   "tipo": "objeto",
   "t": 21.426,
   "texto": "Os outros sete caem na pilha, um por batida; cada impacto afunda a pilha."
  },
  {
   "cena": "entregas",
   "tipo": "objeto",
   "t": 22.1,
   "texto": "Intencional: cada cartão bate na pilha e para seco, como um objeto com peso; a pilha inteira afunda e devolve."
  },
  {
   "cena": "entregas",
   "tipo": "objeto",
   "t": 23.709,
   "texto": "Batida 8: a pilha explode em espiral numa órbita que nunca para."
  },
  {
   "cena": "entregas",
   "tipo": "tipo",
   "t": 24.035,
   "texto": "'Do pedido à entrega' sobe; 'entrega' acende."
  },
  {
   "cena": "entregas",
   "tipo": "transicao",
   "t": 25.815,
   "texto": "A câmera atravessa a órbita, chegando na montagem no início da frase."
  },
  {
   "cena": "montagem",
   "tipo": "objeto",
   "t": 26.317,
   "texto": "Compasso 1: o artefato chega num chicote da direita, girado 16° em 3D, e assenta."
  },
  {
   "cena": "montagem",
   "tipo": "tipo",
   "t": 26.377,
   "texto": "O nome sai do desfoque letra a letra, 16 ms entre elas."
  },
  {
   "cena": "montagem",
   "tipo": "objeto",
   "t": 26.437,
   "texto": "As peças saltam no lugar ao longo de três batidas, com mola curta."
  },
  {
   "cena": "montagem",
   "tipo": "transicao",
   "t": 27.457,
   "texto": "Nos últimos 160 ms tudo sai pela esquerda acelerando e o próximo já entra pela direita."
  },
  {
   "cena": "montagem",
   "tipo": "transicao",
   "t": 30.317,
   "texto": "Intencional: o cartão branco de Documentos sai pela borda esquerda no chicote, rápido e contrastado."
  },
  {
   "cena": "montagem",
   "tipo": "vida",
   "t": 31.517,
   "texto": "A cada compasso os lados se invertem e a luz troca de lado, sempre por trás do artefato."
  },
  {
   "cena": "mosaico",
   "tipo": "objeto",
   "t": 36.753,
   "texto": "Um artefato bate por batida, vindo de perto da câmera, com mola."
  },
  {
   "cena": "mosaico",
   "tipo": "tipo",
   "t": 39.362,
   "texto": "Batida 8: o mosaico recua e escurece; a frase sai do desfoque na frente."
  },
  {
   "cena": "mosaico",
   "tipo": "luz",
   "t": 40.014,
   "texto": "'uma frase' acende em terracota."
  },
  {
   "cena": "mosaico",
   "tipo": "transicao",
   "t": 41.318,
   "texto": "Batida 14: tudo é tragado para o centro e vira o ponto de luz do fecho."
  },
  {
   "cena": "fecho",
   "tipo": "luz",
   "t": 42.031,
   "texto": "Na queda da música, o ponto vira a faísca com o mesmo gesto da resposta."
  },
  {
   "cena": "fecho",
   "tipo": "tipo",
   "t": 42.891,
   "texto": "'Claude' nasce da luz."
  },
  {
   "cena": "fecho",
   "tipo": "tipo",
   "t": 43.631,
   "texto": "Na última pancada da música, o convite pousa com um clarão e um empurrão de câmera."
  },
  {
   "cena": "fecho",
   "tipo": "vida",
   "t": 44.871,
   "texto": "Hold no silêncio: brilho em 'Claude', a faísca gira."
  },
  {
