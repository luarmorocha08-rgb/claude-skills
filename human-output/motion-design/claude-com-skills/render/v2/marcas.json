 "batidas": [
  {
   "cena": "pedido",
   "tipo": "luz",
   "t": 0,
   "texto": "O cursor acende e respira devagar, como quem espera."
  },
  {
   "cena": "pedido",
   "tipo": "tipo",
   "t": 0.24,
   "texto": "A digitação começa com ritmo humano (42 a 64 ms por letra, pausa curta na troca de palavra) e a câmera recua de um close de 1,1×; cada letra nasce quente, do desfoque, e esfria."
  },
  {
   "cena": "pedido",
   "tipo": "vida",
   "t": 1.6,
   "texto": "Hold: a brasa atrás do cursor respira e a câmera segue chegando."
  },
  {
   "cena": "pedido",
   "tipo": "transicao",
   "t": 2.6,
   "texto": "Na batida, as pontas da frase partem primeiro e tudo converge num ponto de luz no centro em 300 ms; o ponto floresce e a cena corta nele."
  },
  {
   "cena": "faisca",
   "tipo": "luz",
   "t": 3.05,
   "texto": "O ponto cresce e vira a faísca com uma mola curta, girando de −70° e esfriando de quase branco até terracota."
  },
  {
   "cena": "faisca",
   "tipo": "objeto",
   "t": 3.57,
   "texto": "O gesto-assinatura: meia chave em 240 ms (os raios viram risco) e passa 6° do ponto, voltando."
  },
  {
   "cena": "faisca",
   "tipo": "tipo",
   "t": 3.83,
   "texto": "A faísca desliza para a esquerda e 'Claude' nasce da luz, letra a letra, quente."
  },
  {
   "cena": "faisca",
   "tipo": "tipo",
   "t": 4.55,
   "texto": "'com skills' sobe do desfoque; na meia batida o véu varre e acende 'skills' em terracota."
  },
  {
   "cena": "faisca",
   "tipo": "vida",
   "t": 5.6,
   "texto": "Hold: um brilho atravessa 'Claude', a faísca gira um fio e a luz respira."
  },
  {
   "cena": "faisca",
   "tipo": "transicao",
   "t": 6.25,
   "texto": "As letras são tragadas para a faísca; ela vai ao centro e cresce até o tamanho do sol da próxima cena. Corte invisível."
  },
  {
   "cena": "oficios",
   "tipo": "objeto",
   "t": 7.43,
   "texto": "A faísca prende o ar (encolhe 6 %)."
  },
  {
   "cena": "oficios",
   "tipo": "luz",
   "t": 7.55,
   "texto": "Na batida, os oito feixes disparam no sentido do relógio, 45 ms entre eles, cada um com uma cabeça de luz."
  },
  {
   "cena": "oficios",
   "tipo": "tipo",
   "t": 7.85,
   "texto": "Na ponta de cada feixe nasce um ofício, do desfoque, quando a luz chega."
  },
  {
   "cena": "oficios",
   "tipo": "vida",
   "t": 9.05,
   "texto": "Hold: uma onda de luz corre pelos feixes uma vez, a faísca gira devagar, a câmera chega."
  },
  {
   "cena": "oficios",
   "tipo": "luz",
   "t": 10.55,
   "texto": "A escolha: 'Motion design' esquenta até a terracota, o feixe dele acende, os outros apagam e desfocam."
  },
  {
   "cena": "oficios",
   "tipo": "transicao",
   "t": 11.3,
   "texto": "A câmera mergulha dentro do 'o' de 'Motion' até o escuro de dentro da letra virar a próxima cena."
  },
  {
   "cena": "bastidor",
   "tipo": "tipo",
   "t": 11.45,
   "texto": "'Inclusive este vídeo' sai do desfoque letra a letra."
  },
  {
   "cena": "bastidor",
   "tipo": "objeto",
   "t": 11.9,
   "texto": "Os seis quadrinhos caem em accelerando (110 → 50 ms), cada um com um estalo pequeno."
  },
  {
   "cena": "bastidor",
   "tipo": "luz",
   "t": 12.3,
   "texto": "A régua de batidas se desenha da esquerda para a direita."
  },
  {
   "cena": "bastidor",
   "tipo": "luz",
   "t": 12.8,
   "texto": "A linha de luz percorre a régua e acende cada quadrinho quando passa; o quadrinho 4 é este, com a prancha dentro dele."
  },
  {
   "cena": "bastidor",
   "tipo": "transicao",
   "t": 15.7,
   "texto": "Os outros recuam e escurecem; a câmera mergulha no quadrinho 5 até ele virar a cena seguinte."
  },
  {
   "cena": "entregas",
   "tipo": "objeto",
   "t": 16.05,
   "texto": "O cartão de Motion assenta no embalo do mergulho."
  },
  {
   "cena": "entregas",
   "tipo": "objeto",
   "t": 16.6,
   "texto": "Os outros caem na pilha em accelerando (80 → 30 ms); cada impacto afunda a pilha, que devolve."
  },
  {
   "cena": "entregas",
   "tipo": "objeto",
   "t": 17.55,
   "texto": "Na batida 3, a pilha que prendeu o ar explode em espiral e vira uma órbita que nunca para."
  },
  {
   "cena": "entregas",
   "tipo": "tipo",
   "t": 18.05,
   "texto": "'Do pedido à entrega' sobe palavra a palavra no vazio do centro; o destaque acende."
  },
  {
   "cena": "entregas",
   "tipo": "vida",
   "t": 19.45,
   "texto": "Hold: a órbita gira, um brilho atravessa 'entrega'."
  },
  {
   "cena": "entregas",
   "tipo": "transicao",
   "t": 20.55,
   "texto": "A câmera atravessa a órbita: os cartões passam rente e saem desfocados."
  },
  {
   "cena": "fecho",
   "tipo": "luz",
   "t": 21.15,
   "texto": "Um ponto acende no escuro e vira a faísca, com o mesmo gesto da resposta (rima)."
  },
  {
   "cena": "fecho",
   "tipo": "tipo",
   "t": 21.9,
   "texto": "A faísca desliza e 'Claude' nasce da luz dela."
  },
  {
   "cena": "fecho",
   "tipo": "tipo",
   "t": 22.55,
   "texto": "O convite sobe palavra a palavra; 'especialista' acende em terracota."
  },
  {
   "cena": "fecho",
   "tipo": "vida",
   "t": 23.65,
   "texto": "Hold: brilho em 'Claude', a faísca gira um fio."
  },
  {
   "cena": "fecho",
   "tipo": "transicao",
   "t": 24.45,
   "texto": "Tudo é tragado para a faísca; ela vai ao centro, gira cada vez mais rápido, vira um ponto, solta um traço horizontal de luz e apaga."
  }
 ],
